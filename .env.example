# 复制为 .env 后按环境修改
# 数据库：与现有项目共用同一 MySQL 8.x 实例，AIQC 使用独立逻辑库 aiqc
# 首次使用前在该 MySQL 执行：CREATE DATABASE aiqc CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql://root:password@localhost:3306/aiqc"

# 后台登录会话签名密钥（生产务必改为随机长字符串：openssl rand -base64 32）
AUTH_SECRET="change-me-in-production"
